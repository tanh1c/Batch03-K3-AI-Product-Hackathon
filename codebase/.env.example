# Selected provider: 9router (default), openai, openrouter, or gemini.
AI_PROVIDER=9router

# Local 9router gateway. NINEROUTER_KEY is optional when gateway auth is disabled.
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
NINEROUTER_MODEL=gc/gemini-2.5-flash

# OpenAI settings used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# OpenRouter settings used only when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Direct Google Gemini settings used only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3000
